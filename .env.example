# Google Sheets CSV URLs
# Get these from File > Share > Publish to web > CSV format
# Replace YOUR_SPREADSHEET_ID with your actual Google Spreadsheet ID
BHAJANS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/export?format=csv&gid=0
# Replace YOUR_AUTHORS_GID with the gid shown in the URL when the Authors tab is selected
AUTHORS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/export?format=csv&gid=YOUR_AUTHORS_GID
